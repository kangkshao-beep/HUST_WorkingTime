    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Working Hour uses your location to automatically clock you in and out when you arrive at or leave your workplace."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "職場に到着した時や離れた時に自動的に出勤・退勤を記録するために位置情報を使用します。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Working Hour 會使用你的位置，在你抵達或離開工作地點時自動記錄上班及下班。"
          }
        }
      }
    },
